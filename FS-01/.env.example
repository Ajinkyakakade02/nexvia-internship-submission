# ============================================================
# FS-01 Multi-Vendor E-Commerce Marketplace
# Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# ──────────────────────────────────────────────────────────────
# APPLICATION
# ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

# ──────────────────────────────────────────────────────────────
# POSTGRESQL (PRISMA ORM)
# ──────────────────────────────────────────────────────────────
# Local Docker: postgresql://postgres:postgrespassword@localhost:5432/fs01_marketplace?schema=public
# Hosted (e.g. Supabase, Neon, AWS RDS): postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/fs01_marketplace?schema=public

# ──────────────────────────────────────────────────────────────
# MONGODB (TEMPORARY — Retained during migration transition)
# ──────────────────────────────────────────────────────────────
# Local: mongodb://localhost:27017/fs01_marketplace
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fs01_marketplace
MONGODB_URI=mongodb://localhost:27017/fs01_marketplace

# ──────────────────────────────────────────────────────────────
# JWT AUTHENTICATION
# ──────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ──────────────────────────────────────────────────────────────
# REDIS
# ──────────────────────────────────────────────────────────────
# Local Docker: redis://localhost:6379
# Hosted: redis://<user>:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────────────────────
# ELASTICSEARCH
# ──────────────────────────────────────────────────────────────
# Local Docker: http://localhost:9200
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ──────────────────────────────────────────────────────────────
# AWS S3 — Image Storage
# ──────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set to 'local' to use local file storage in development
STORAGE_PROVIDER=local

# ──────────────────────────────────────────────────────────────
# RAZORPAY — Test Mode Only
# ──────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Set to 'simulation' when Razorpay credentials are not configured
PAYMENT_PROVIDER=simulation

# ──────────────────────────────────────────────────────────────
# PLATFORM CONFIGURATION
# ──────────────────────────────────────────────────────────────
PLATFORM_NAME=NexMart
PLATFORM_COMMISSION_PERCENT=10
DEFAULT_CURRENCY=INR

# ──────────────────────────────────────────────────────────────
# ADMIN SEED
# ──────────────────────────────────────────────────────────────
# Used by the seed:admin script to create the initial admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin

# ──────────────────────────────────────────────────────────────
# RATE LIMITING
# ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=20

